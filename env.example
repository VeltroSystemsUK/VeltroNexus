# FlowLoan Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================================================
# REQUIRED - Database
# ============================================================================
DATABASE_URL=postgresql://user:password@host:port/database

# ============================================================================
# REQUIRED - Authentication & Security
# ============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_32_character_or_longer_session_secret_here_change_me
WEBHOOK_KEY_SECRET=your_32_character_or_longer_webhook_secret_here_change_me

# ============================================================================
# REQUIRED - External APIs
# ============================================================================
# UK Companies House API
COMPANIES_HOUSE_API_KEY=your_companies_house_api_key

# GoCardless Payment Processing
GOCARDLESS_ACCESS_TOKEN=your_gocardless_access_token
GOCARDLESS_ENVIRONMENT=sandbox  # or 'live' for production

# Resend Email Service
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ============================================================================
# OPTIONAL - Redis (Required for Production)
# ============================================================================
# Format: redis://[username]:[password]@[host]:[port]/[db_number]
# REDIS_URL=redis://default:password@localhost:6379/0

# ============================================================================
# OPTIONAL - CORS Configuration
# ============================================================================
# Comma-separated list of allowed origins
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ============================================================================
# OPTIONAL - Rate Limiting Overrides
# ============================================================================
# Default values are shown below - only set if you need to override

# Webhook rate limiting
# RATE_LIMIT_WEBHOOK=60
# RATE_LIMIT_WEBHOOK_WINDOW_MS=60000

# PDF parsing rate limiting
# RATE_LIMIT_PDF_PARSE=30
# RATE_LIMIT_PDF_PARSE_WINDOW_MS=60000

# AI endpoint rate limiting
# RATE_LIMIT_AI=20
# RATE_LIMIT_AI_WINDOW_MS=60000

# Authentication endpoint rate limiting
# RATE_LIMIT_AUTH=10
# RATE_LIMIT_AUTH_WINDOW_MS=60000

# Upload endpoint rate limiting
# RATE_LIMIT_UPLOAD=30
# RATE_LIMIT_UPLOAD_WINDOW_MS=60000

# ============================================================================
# OPTIONAL - Google Gemini AI
# ============================================================================
# GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key

# ============================================================================
# Node Environment
# ============================================================================
NODE_ENV=development  # or 'production'
