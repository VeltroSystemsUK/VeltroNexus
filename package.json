  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/clear-port.js && (tsx watch --exclude 'uploads/**' --exclude 'tmp/**' --exclude '**/*.db*' --env-file=.env.local server/index.ts & vite --port 5173)",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "postbuild": "schtasks /run /tn \"RestartNexusApp\" || echo Could not auto-restart NexusApp - run scripts\\restart-nexus.bat",
    "start": "node --env-file=.env.production dist/index.js",
    "check": "tsc",
    "slf": "tsx scripts/slf.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:security": "npm audit --audit-level=moderate",
    "lint": "eslint .",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "db:local": "firebase emulators:start --only firestore,auth --import=./local-db --export-on-exit"
  },
